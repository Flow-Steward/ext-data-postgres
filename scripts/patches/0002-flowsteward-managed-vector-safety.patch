+
+func TestFlowStewardOrdinarySourceKeepsItsPoolConfiguration(t *testing.T) {
+	tracer := noop.NewTracerProvider().Tracer("test")
+	pool, err := initPostgresConnectionPool(context.Background(), tracer, "legacy", "db.example", "5432", "u", "p", "db", map[string]string{"sslmode": "disable"}, "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	if pool.Config().MaxConns == 1 {
+		t.Fatal("vector pool limits leaked into ordinary SQL")
+	}
+}
+
+func TestFlowStewardManagedVectorEndpointAndWireLimits(t *testing.T) {
+	tracer := noop.NewTracerProvider().Tracer("test")
+	for _, params := range []map[string]string{
+		{"fs_vector_mode": "true", "sslmode": "verify-full"},
+		{"fs_vector_mode": "true", "fs_pinned_ips": "127.0.0.1", "sslmode": "disable"},
+		{"fs_vector_mode": "true", "fs_pinned_ips": "8.8.8.8", "sslmode": "disable"},
+		{"fs_vector_mode": "true", "fs_pinned_ips": "invalid", "sslmode": "verify-full"},
+	} {
+		pool, err := initPostgresConnectionPool(context.Background(), tracer, "test", "db.example", "5432", "u", "p", "db", params, "", nil)
+		if pool != nil {
+			pool.Close()
+		}
+		if err == nil {
+			t.Fatal("unsafe vector endpoint accepted")
+		}
+	}
+	params := map[string]string{"fs_vector_mode": "true", "fs_pinned_ips": "8.8.8.8", "sslmode": "verify-full"}
+	pool, err := initPostgresConnectionPool(context.Background(), tracer, "test", "db.example", "5432", "u", "p", "db", params, "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	cfg := pool.Config()
+	if len(cfg.ConnConfig.Fallbacks) != 0 || cfg.MaxConns != 1 || cfg.ConnConfig.ConnectTimeout != 5*time.Second {
+		t.Fatal("unsafe fallback or pool configuration")
+	}
+	if cfg.ConnConfig.TLSConfig == nil || cfg.ConnConfig.TLSConfig.InsecureSkipVerify || cfg.ConnConfig.TLSConfig.ServerName != "db.example" {
+		t.Fatal("TLS hostname verification was lost")
+	}
+	if _, err := cfg.ConnConfig.DialFunc(context.Background(), "tcp", "other.example:5432"); err == nil {
+		t.Fatal("unexpected endpoint accepted")
+	}
+	frame := make([]byte, 5)
+	frame[0] = 'D'
+	binary.BigEndian.PutUint32(frame[1:], 3*1024*1024)
+	frontend := cfg.ConnConfig.BuildFrontend(bytes.NewReader(frame), io.Discard)
+	_, err = frontend.Receive()
+	if err == nil || err == io.EOF || err == io.ErrUnexpectedEOF {
+		t.Fatalf("large frame was not rejected before reading body: %v", err)
+	}
+}
+
+func TestFlowStewardManagedVectorTimeoutCannotBeOverridden(t *testing.T) {
+	tracer := noop.NewTracerProvider().Tracer("test")
+	timeout := 30
+	pool, err := initPostgresConnectionPool(context.Background(), tracer, "test", "db.example", "5432", "u", "p", "db", map[string]string{"fs_vector_mode": "true", "fs_pinned_ips": "8.8.8.8", "sslmode": "verify-full"}, "", &timeout)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	if pool.Config().ConnConfig.ConnectTimeout != 5*time.Second {
+		t.Fatal("managed vector timeout overridden")
+	}
+}
